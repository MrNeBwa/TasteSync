{
  "name": "@movie-match/mobile",
  "private": true,
  "version": "0.2.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "node scripts/generate-typed-routes.js && tsc --noEmit",
    "typecheck": "node scripts/generate-typed-routes.js && tsc --noEmit",
    "prebuild:android": "expo prebuild --platform android && node scripts/configure-android-release.js",
    "apk:debug": "cd android && ./gradlew assembleDebug",
    "apk:release": "bash scripts/build-release-apk.sh",
    "keystore": "bash scripts/generate-upload-keystore.sh"
  },
  "dependencies": {
    "expo": "^53.0.20",
    "expo-camera": "~16.1.11",
    "expo-constants": "~17.1.8",
    "expo-router": "^5.1.4",
    "expo-secure-store": "~14.2.4",
    "react": "19.0.0",
    "react-native": "^0.79.5",
    "react-native-qrcode-svg": "^6.3.24",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "^15.15.5",
    "react-native-webview": "13.13.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.10",
    "typescript": "^5.8.3"
  }
}
