APP_NAME=movie-match-api
ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://movie:movie@localhost:5432/movie_match
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Optional: TMDB API read access token (https://www.themoviedb.org/settings/api).
# With it the catalog is real (posters, trailers). Without it - or if the network
# blocks api.themoviedb.org - the API seeds a bundled 40-film offline fallback.
TMDB_API_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ALL_LOCAL=true
CORS_ORIGIN_REGEX=^https?://(?:localhost|127\.0\.0\.1|192\.168\.\d+\.\d+|10\.\d+\.\d+\.\d+|172\.(?:1[6-9]|2\d|3[0-1])\.\d+\.\d+|169\.254\.\d+\.\d+):(?:5173|4173|3000|8080)$