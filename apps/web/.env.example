# Development: Vite proxies /api and /ws to this local target.
# You normally do not need to change this.
VITE_API_PORT=8000
VITE_DEV_API_TARGET=http://127.0.0.1:8000

# Production only. Leave empty for same-origin deployment behind a reverse proxy.
# VITE_API_URL=https://api.example.com/api
# VITE_WS_URL=wss://api.example.com
