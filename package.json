{
  "name": "movie-match",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev:web": "pnpm --filter @movie-match/web dev",
    "dev:mobile": "pnpm --filter @movie-match/mobile start",
    "dev:api": "cd apps/api && uv run fastapi dev app/main.py",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "turbo": "^2.5.6"
  }
}
